# ── Client (must be prefixed with VITE_) ──
# This app's own origin, no trailing slash.
VITE_BASE_URL=http://localhost:4000

# The backend's origin, no trailing slash. Every API and auth call goes here.
# The backend must list VITE_BASE_URL in its CORS and Better Auth trustedOrigins.
VITE_API_URL=http://localhost:3000
